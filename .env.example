# OmniPulse Multi-Channel Sync Engine Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/omnipulse?schema=public"

# Redis Cache & BullMQ Queue (Upstash / Local Redis)
REDIS_URL="redis://localhost:6379"

# Edge Webhook Secrets
WEBHOOK_SECRET_SHOPIFY="shpss_live_webhook_secret_key"
WEBHOOK_SECRET_EBAY="ebay_verification_token_key"
WEBHOOK_SECRET_WOOCOMMERCE="wc_webhook_secret_key"

# Marketplace API Credentials
# Shopify Partner App
SHOPIFY_API_KEY="your_shopify_api_key"
SHOPIFY_API_SECRET="your_shopify_api_secret"
SHOPIFY_SCOPES="read_products,write_products,read_inventory,write_inventory,read_orders"

# eBay Developer Portal (Sell Inventory API)
EBAY_CLIENT_ID="your_ebay_client_id"
EBAY_CLIENT_SECRET="your_ebay_client_secret"
EBAY_RU_NAME="your_ebay_runame"
EBAY_ENVIRONMENT="PRODUCTION" # SANDBOX or PRODUCTION

# WooCommerce REST API v3
WOOCOMMERCE_STORE_URL="https://yourstore.com"
WOOCOMMERCE_CONSUMER_KEY="ck_live_consumer_key"
WOOCOMMERCE_CONSUMER_SECRET="cs_live_consumer_secret"

# App & Telemetry
PORT=3000
NODE_ENV="production"
LOG_LEVEL="info"
